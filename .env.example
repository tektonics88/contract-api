# ---------------------------------------------------------------------------
# Contract Review API — environment configuration
# Copy this file to ".env" and fill in the values. Never commit your real .env.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Claude / Anthropic (required for analysis) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096

# --- Supabase / Postgres (required for auth + usage logging) ---
# From your Supabase project: Settings -> API.
# Use the SERVICE ROLE key (server-side only — bypasses row-level security).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Rate limiting (per API key) ---
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# --- Uploads ---
# Max PDF upload size in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760

# --- Dev only ---
# When true, /analyze SKIPS API-key auth so you can test analysis without
# Supabase. NEVER set this in production (the server refuses to start with
# DISABLE_AUTH=true and NODE_ENV=production).
DISABLE_AUTH=false
